# 이 파일을 .env 로 복사한 뒤 아래 세 값을 채운다. 값은 설치할 때 무작위로 만든다(이 파일에 박지 않는다).
#   cp .env.example .env
#   sed -i.bak "s|^DB_PASSWORD=.*|DB_PASSWORD=$(openssl rand -hex 24)|; s|^SESSION_SECRET=.*|SESSION_SECRET=$(openssl rand -hex 32)|; s|^DATA_KEY=.*|DATA_KEY=$(openssl rand -hex 32)|" .env && rm .env.bak && chmod 600 .env
# 🔴 DATA_KEY 는 잃어버리면 암호화 칸(보결 사유·메모)을 못 연다. .env 를 따로 보관한다. 바꾸지 않는다.
DB_PASSWORD=
SESSION_SECRET=
DATA_KEY=
# HTTPS 로 접속하면 true(기본). http 로만 시험할 때만 false.
COOKIE_SECURE=true
# 밖으로 여는 주소·포트. 기본은 이 서버 안에서만(127.0.0.1) — 앞단 웹서버/프록시가 받는다.
BIND=127.0.0.1
APP_PORT=3000
