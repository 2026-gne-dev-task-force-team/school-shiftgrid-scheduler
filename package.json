{
  "name": "school-timetable",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "우리학교 시간표 — 완전 통합본",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/migrate.js && node server/index.js",
    "migrate": "node server/migrate.js",
    "seed:admin": "node scripts/seed-admin.js",
    "check": "node --check server/index.js && node --check server/app.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "build:web": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
